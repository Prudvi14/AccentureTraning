@model LaptopCart.Models.Product

<div class="card border-0">
    <div class="card-header ms-0 text-white" style="background-color: lightgreen">
        <h1 class="p-2 text-center">Create Product</h1>
    </div>
    <div class="card-body mt-3 text-white">
        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="form-floating mb-3">
                <input asp-for="Name" class="form-control" placeholder="" />
                <label class="ms-2 text-muted">Name</label>
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Description" class="form-control" placeholder="" />
                <label class="ms-2 text-muted">Description</label>
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <div class="form-floating mb-3">
                <input asp-for="Price" class="form-control" placeholder="" />
                <label class="ms-2 text-muted">Price</label>
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>

            <div class="mb-3 text-muted ms-1">
                <label asp-for="ImageFile" class="form-label">Product Image</label>
                <input asp-for="ImageFile" type="file" class="form-control" placeholder="" />
                <span asp-validation-for="ImageFile" class="text-danger"></span>
            </div>

            <div class="d-flex justify-content-center">
                <button type="submit" class="w-100 btn btn-dark">Add Product</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}